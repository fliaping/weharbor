# Generated credentials and host UID/GID are filled by scripts/init.sh.
WEHARBOR_IMAGE=weharbor:0.1.0
CUSTOM_USER=weharbor
# Must not start with "-" (the Selkies base passes it to `openssl passwd`).
PASSWORD=
PUID=1000
PGID=1000
TZ=Asia/Shanghai
DATA_DIR=./data
SHM_SIZE=1gb

# Set BIND_ADDRESS=0.0.0.0 for access from other machines. Keep login enabled.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
HTTPS_PORT=3001

AUTO_START_WECHAT=true
ENABLE_APP_SWITCHER=true
APP_SWITCHER_MODE=web
ENABLE_WINDOW_DEFAULTS=true
ENABLE_BROWSER_NOTIFICATIONS=true
ENABLE_MAGPIE=true
SELKIES_ENABLE_BINARY_CLIPBOARD=true

# ---- 远程访问（可选，默认全部关闭；也可在网页「连接」页面配置，环境变量优先）----
# 暴露到公网（Cloudflare Tunnel / frp）前务必设置强 PASSWORD。详见 docs/remote-access.md
# Tailscale（用户态网络，无需 NET_ADMIN/TUN；状态保存在 /config）
TAILSCALE_ENABLE=
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=
# Headscale 等自建控制服务器
TAILSCALE_LOGIN_SERVER=
# true：用 tailscale serve 在 tailnet 内提供 https://<主机名>.<tailnet>.ts.net
TAILSCALE_SERVE=
TAILSCALE_EXTRA_ARGS=
# Cloudflare Tunnel：公开域名指向 https://localhost:3001（No TLS Verify）或 http://localhost:3000
CLOUDFLARE_TUNNEL_ENABLE=
CLOUDFLARE_TUNNEL_TOKEN=
# frp（frpc 客户端）；或挂载 /config/frp/frpc.toml 完全自定义（FRP_MODE=raw）
FRP_ENABLE=
FRP_MODE=
FRP_SERVER_ADDR=
FRP_SERVER_PORT=
FRP_TOKEN=
# tcp（FRP_REMOTE_PORT → 本机 3001）/ https（域名 SNI 透传 → 3001）/ http（域名 → 3000）
FRP_PROXY_TYPE=
FRP_REMOTE_PORT=
FRP_CUSTOM_DOMAIN=
FRP_PROXY_NAME=
FRP_TLS=
