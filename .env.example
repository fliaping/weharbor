# Generated credentials and host UID/GID are filled by scripts/init.sh.
WEHARBOR_IMAGE=weharbor:0.1.0
CUSTOM_USER=weharbor
PASSWORD=
PUID=1000
PGID=1000
TZ=Asia/Shanghai
DATA_DIR=./data
SHM_SIZE=1gb

# Set BIND_ADDRESS=0.0.0.0 for access from other machines. Keep login enabled.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
HTTPS_PORT=3001
API_BIND_ADDRESS=127.0.0.1
WEFLOW_API_PORT=5031

AUTO_START_WECHAT=true
AUTO_START_WEFLOW=true
ENABLE_APP_SWITCHER=true
ENABLE_BROWSER_NOTIFICATIONS=true
SELKIES_ENABLE_BINARY_CLIPBOARD=true
ENABLE_WECHAT_AUTO_LOGIN=true
AUTO_LOGIN_DELAY=3
ENABLE_WECHAT_NIGHTLY_RESTART=false
WECHAT_NIGHTLY_STOP_TIME=23:30
WECHAT_NIGHTLY_START_TIME=01:30
